        "/projects/:id/add_related_proposal": {
            "post": {
                "tags": [
                    "project"
                ],
                "summary": "Add related proposals to the project",
                "parameters": [
                    {
                        "type": "number",
                        "description": "project ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "csv",
                        "description": "proposal ID list",
                        "name": "proposalIDs",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ok",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/projects/:id/close": {
            "post": {
