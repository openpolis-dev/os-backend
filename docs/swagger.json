                "summary": "Create a project with passed in data",
                "parameters": [
                    {
                        "description": "new project request data",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/project.CreateReq"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/projects/:id": {
            "get": {
                "tags": [
                    "project"
                ],
                "summary": "show detail of a project",
