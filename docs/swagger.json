    "basePath": "/v1",
    "paths": {
        "/app_bundles": {
            "get": {
                "tags": [
                    "app_bundle"
                ],
                "summary": "List all application bundles match the query params",
                "parameters": [
                    {
                        "type": "string",
                        "description": "status of application bundle",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "which page",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "size of each page",
                        "name": "size",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "sort by which field",
                        "name": "sort_field",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "order of sort",
                        "name": "sort_order",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/app_bundle.AppBundleResponseRecord"
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "app_bundle"
                ],
                "summary": "List all application bundles match the query params",
                "parameters": [
                    {
                        "description": "New application bundle request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.NewAppBundleRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/app_bundles/:id/approve": {
            "post": {
                "tags": [
                    "app_bundle"
                ],
                "summary": "Approve app bundle and associated applications",
                "parameters": [
                    {
                        "type": "number",
                        "description": "app bundle ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/app_bundles/:id/reject": {
            "post": {
                "tags": [
                    "app_bundle"
                ],
                "summary": "Reject app bundle and associated applications",
                "parameters": [
                    {
                        "type": "number",
                        "description": "app bundle ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
