# spp-indexer.seedao.top — 宿主机 Nginx 示例（对齐 sns-api.seedao.top 模式）
#
# 前提（见 docker-compose.prod.yml）：
#   - spp-indexer → 9094:3000，站点根路径反代到 http://127.0.0.1:9094
#   - sns_api → 9092:8090；路径以 /sns/ 开头的请求须反代到 http://127.0.0.1:9092
#     否则 POST /sns/... 会打到 indexer，易出现 upstream timed out / 504。
#   若 SNS 后端校验 Host，可将下面 location /sns/ 中的 Host 改为 sns-api.seedao.top。
#
# --- 在服务器上操作（需 sudo）---
#
# 1) DNS：spp-indexer.seedao.top 的 A 记录指向本机公网 IP。
#
# 2) ACME 校验目录（与 sns-api 共用即可，若已有可跳过）：
#    sudo mkdir -p /var/www/_acme-challenge
#
# 3) 申请证书：
#    ~/.acme.sh/acme.sh --issue -d spp-indexer.seedao.top -w /var/www/_acme-challenge
#
# 4) 安装到 Nginx 读取路径并配置 reload（路径与下面 ssl_certificate 一致）：
#    sudo mkdir -p /etc/nginx/ssl/spp-indexer.seedao.top
#    ~/.acme.sh/acme.sh --install-cert -d spp-indexer.seedao.top \
#      --key-file       /etc/nginx/ssl/spp-indexer.seedao.top/privkey.pem \
#      --fullchain-file /etc/nginx/ssl/spp-indexer.seedao.top/fullchain.pem \
#      --reloadcmd      'sudo nginx -t && sudo systemctl reload nginx'
#
# 5) 启用站点配置（一键写入，与下面两个 server{} 内容一致）：
#    cd /srv/seedao && sudo bash nginx/install-spp-indexer-nginx-conf.sh
#    cd /srv/seedao && sudo bash nginx/install-spp-indexer-nginx-conf.sh --reload
#    或手动：sudo cp spp-indexer.seedao.top.conf.example /etc/nginx/conf.d/spp-indexer.seedao.top.conf
#    sudo nginx -t && sudo systemctl reload nginx
#
# 若 nginx -t 报不支持 `http2 on;`（版本较旧），可改回一行：
#    listen 443 ssl http2;
#    并删除本文件 server 块中的 `http2 on;` 行。

server {
    listen 80;
    server_name spp-indexer.seedao.top;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/_acme-challenge;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name spp-indexer.seedao.top;

    ssl_certificate     /etc/nginx/ssl/spp-indexer.seedao.top/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/spp-indexer.seedao.top/privkey.pem;

    ssl_session_timeout 10m;
    ssl_session_cache shared:SSL:10m;

    location ^~ /sns/ {
        proxy_pass http://127.0.0.1:9092;
        proxy_http_version 1.1;
        proxy_set_header Host sns-api.seedao.top;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:9094;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
